# ── Private preview — HTTP Basic Auth (baked into the repo so it survives every
#    deploy). REMOVE this block at public launch. user: wildcard ──
AuthType Basic
AuthName "The Jitz Guild - Private Preview"
AuthUserFile ".htpasswd"
Require valid-user

# ── The Jitz Guild — server rules (thejitsguild.com) ──
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # normalize any www.<host> -> non-www (works for thejitsguild.com and the old domain)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
